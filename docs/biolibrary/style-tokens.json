{
  "standard": "BioPlot Scientific Soft-Volume",
  "version": "1.0.0",
  "status": "baseline-pending-pilot-approval",
  "scope": "design-reference-only; not loaded automatically by the running editor",
  "canvas": {
    "viewBox": [
      0,
      0,
      512,
      512
    ],
    "background": "transparent",
    "recommendedMinClearSpacePercent": 8,
    "footprintPercent": [
      70,
      84
    ]
  },
  "camera": {
    "default": "near-orthographic-3/4",
    "labYawDegrees": [
      10,
      20
    ],
    "exceptions": [
      "front for accurate graduations",
      "anatomic cross-section for scientific clarity"
    ]
  },
  "lighting": {
    "key": "diffuse upper-left 10:30",
    "formShadow": "lower-right",
    "highlightOpacity": [
      0.1,
      0.25
    ],
    "contactShadowOpacity": [
      0.08,
      0.16
    ],
    "filterBlur": "avoid in shipping SVG"
  },
  "stroke": {
    "outerNominal": 1.4,
    "outerRange": [
      1,
      1.8
    ],
    "innerRange": [
      0.8,
      1.2
    ],
    "detailRange": [
      0.7,
      1.1
    ],
    "units": "512-viewBox-units",
    "roundWhereAppropriate": true
  },
  "colors": {
    "ink": "#486171",
    "inkDeep": "#354C5D",
    "plasticLight": "#E9F0F3",
    "plasticMid": "#C5D3DB",
    "plasticShade": "#91A7B5",
    "glassHighlight": "#FFFFFF",
    "capBlue": "#457FC4",
    "capBlueShadow": "#2C5D99",
    "tealAccent": "#45A9A3",
    "liquidCyan": "#6BC6D1",
    "organelleCoral": "#E8A28C",
    "nucleusLavender": "#A999D7",
    "membraneSage": "#9CC6B1"
  },
  "gradient": {
    "curvedSurfaceStops": [
      3,
      5
    ],
    "highlightRegionsMax": 2,
    "namingPrefix": "bp-grad-",
    "localFragmentReferencesOnly": true
  },
  "structure": {
    "semanticIdPrefix": "bp-",
    "editableRegions": [
      "cap",
      "liquid",
      "label"
    ],
    "defaultLocked": [
      "highlights",
      "shadows",
      "outline"
    ],
    "requireTrueVector": true,
    "requireStandaloneSvg": true,
    "allowExternalResources": false
  },
  "export": {
    "master": "SVG",
    "web": "sanitized-compatible SVG",
    "preview": "PNG transparent 1024x1024",
    "thumbnail": "generated by current catalog preview pipeline",
    "targetSvgBytes": 250000,
    "reviewSvgBytesOver": 500000,
    "uploadLimitBytesObserved": 2500000
  },
  "checks": {
    "previewSizes": [
      64,
      128,
      256,
      512
    ],
    "backgrounds": [
      "#FFFFFF",
      "#F2F5F7"
    ],
    "editorRoundTrip": true,
    "scientificReview": true,
    "manualApproval": true
  },
  "implementationNote": "Current BioPlot colorSlots uses literal hex replacement; semantic-region/gradient recoloring is future work."
}
