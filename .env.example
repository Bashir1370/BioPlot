# Optional cloud persistence and Supabase Realtime collaboration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Enable only after applying private Realtime topic policies (see supabase/SETUP.md).
VITE_BIOPLOT_REMOTE_COLLABORATION=false

# Optional remote AI drafting endpoint. Without this, BioPlot uses the local editable-draft provider.
VITE_BIOPLOT_AI_ENDPOINT=
